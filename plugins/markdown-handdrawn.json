  "repository": "https://github.com/SECTL/SecAgent-Markdown-Handdrawn-Plugin",
  "icon": "https://raw.githubusercontent.com/SECTL/SecAgent-Markdown-Handdrawn-Plugin/main/icon.svg",
  "readme": "https://raw.githubusercontent.com/SECTL/SecAgent-Markdown-Handdrawn-Plugin/main/README.md",
  "minHostApiVersion": 1,
  "permissions": ["agent.tools", "agent.skills", "agent.preview", "network.http"],
  "platforms": ["darwin", "linux", "win32"],
  "release": {
    "provider": "github",
    "owner": "SECTL",
    "repo": "SecAgent-Markdown-Handdrawn-Plugin",
    "assetName": "markdown-handdrawn-{version}.zip",
    "includePrerelease": false
  }
